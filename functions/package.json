{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "format": "prettier --write . --ignore-path ../.prettierignore --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore --ignore-path .gitignore",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --only firestore --project demo-broadcast \"vitest run\""
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.25.4",
    "firebase": "^13.0.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "private": true
}
